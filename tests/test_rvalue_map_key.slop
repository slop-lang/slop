(module test-rvalue-map-key
  (@intent "A map or set key that is an rvalue is bound before its address is taken")

  ;; slop_map_put and friends take the key as const void*, so the key needs an
  ;; address. A struct key that is a call result or an inline constructor is an
  ;; rvalue and &(that) is not C (#108). Every operation that hands the runtime
  ;; a key is exercised here with one.

  (type Tag (record (name String) (n Int)))

  (fn make-tag ((n String) (v Int))
    (@intent "Return a Tag by value, so every call below is an rvalue")
    (@spec ((String Int) -> Tag))
    (Tag n v))

  (fn check-set ((arena Arena))
    (@intent "set-put, set-has and set-remove with rvalue elements")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (s (set-new arena Tag)))
      (set-put s (make-tag "a" 1))
      (set-put s (make-tag "b" 2))
      (when (not (set-has s (make-tag "a" 1)))
        (set! fails (+ fails 1)))
      (when (set-has s (make-tag "c" 3))
        (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len (set-elements s))) 2)
        (set! fails (+ fails 1)))
      (set-remove s (make-tag "a" 1))
      (when (set-has s (make-tag "a" 1))
        (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len (set-elements s))) 1)
        (set! fails (+ fails 1)))
      fails))

  (fn check-map ((arena Arena))
    (@intent "map-put, map-get, map-has and map-remove with rvalue keys")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (m (map-new arena Tag Int)))
      (map-put m (make-tag "a" 1) 10)
      (map-put m (make-tag "b" 2) 20)
      (match (map-get m (make-tag "a" 1))
        ((some v) (when (!= v 10) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (match (map-get m (make-tag "c" 3))
        ((some _) (set! fails (+ fails 1)))
        ((none) (do)))
      (when (not (map-has m (make-tag "b" 2)))
        (set! fails (+ fails 1)))
      (when (map-has m (make-tag "c" 3))
        (set! fails (+ fails 1)))
      (map-remove m (make-tag "a" 1))
      (when (map-has m (make-tag "a" 1))
        (set! fails (+ fails 1)))
      fails))

  (fn check-lvalue-keys ((arena Arena))
    (@intent "A key that is a name or a field of one keeps its own address")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (t (make-tag "a" 1))
          (s (set-new arena Tag))
          (m (map-new arena Tag Int)))
      (set-put s t)
      (map-put m t 7)
      (when (not (set-has s t))
        (set! fails (+ fails 1)))
      (match (map-get m t)
        ((some v) (when (!= v 7) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      fails))

  (fn check-scalar-keys ((arena Arena))
    (@intent "A scalar rvalue key still goes through a compound literal")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (m (map-new arena Int Int)))
      (map-put m (+ 1 2) 30)
      (match (map-get m (+ 1 2))
        ((some v) (when (!= v 30) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (when (not (map-has m (+ 2 1)))
        (set! fails (+ fails 1)))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if any key was handled wrongly")
    (@spec (() -> Int))
    (with-arena 262144
      (let ((mut fails 0))
        (set! fails (+ fails (check-set arena)))
        (set! fails (+ fails (check-map arena)))
        (set! fails (+ fails (check-lvalue-keys arena)))
        (set! fails (+ fails (check-scalar-keys arena)))
        fails))))
