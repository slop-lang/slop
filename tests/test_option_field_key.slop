(module test-option-field-key
  (@intent "Option and Result record fields and union payloads hash and compare by content")

  ;; Generated hash/eq used to treat an (Option T) or (Result T E) record
  ;; field as raw bytes: it hashed a String payload's pointer rather than its
  ;; text, plus the padding after the tag, which the arena never zeroes. Two
  ;; literals built separately with the same content -- slop-rdf's
  ;; rdf_Literal, with its (Option String) datatype and lang -- could hash
  ;; differently, compare unequal, and miss each other in a Map or Set.
  ;;
  ;; Every pair below is built from separately allocated strings with equal
  ;; content (string-concat does not intern), so nothing can match by pointer.

  (type Pt (record (x Int) (y Int)))

  (type Lit (record
    (lexical String)
    (datatype (Option String))
    (lang (Option String))
    (parsed (Result Int String))))

  (type Nested (record
    (at (Option Pt))
    (moved (Result Pt String))))

  (type Term (union
    (lit (Option String))
    (res (Result Int String))
    (both Int (Option String))))

  (fn fresh ((arena Arena) (a String) (b String))
    (@intent "A new, uninterned string with the content a ++ b")
    (@spec ((Arena String String) -> String))
    (@alloc arena)
    (string-concat arena a b))

  (fn parse-n ((arena Arena) (n Int))
    (@intent "ok n for a positive n, else a freshly allocated error message")
    (@spec ((Arena Int) -> (Result Int String)))
    (@alloc arena)
    (if (> n 0)
      (ok n)
      (error (fresh arena "not a " "number"))))

  (fn move-to ((arena Arena) (ok-p Bool) (p Pt))
    (@intent "ok p, or a freshly allocated error message")
    (@spec ((Arena Bool Pt) -> (Result Pt String)))
    (@alloc arena)
    (if ok-p
      (ok p)
      (error (fresh arena "lo" "st"))))

  (fn make-lit ((arena Arena) (dt Bool) (n Int))
    (@intent "A literal whose strings are all freshly allocated")
    (@spec ((Arena Bool Int) -> Lit))
    (@alloc arena)
    (let ((datatype (Option String) (if dt (some (fresh arena "xsd:" "integer")) (none)))
          (lang (Option String) (none))
          (parsed (parse-n arena n)))
      (Lit (fresh arena "4" "2") datatype lang parsed)))

  (fn check-record-fields ((arena Arena))
    (@intent "Equal Option/Result record fields are ==, share a Set slot and find each other in a Map")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (a (make-lit arena true 42))
          (b (make-lit arena true 42))
          (c (make-lit arena false 42))
          (d (make-lit arena true 7))
          (e (make-lit arena true 0))
          (f (make-lit arena true 0))
          (s (set-new arena Lit))
          (m (map-new arena Lit Int)))
      (when (not (== a b)) (set! fails (+ fails 1)))
      (when (== a c) (set! fails (+ fails 1)))
      (when (== a d) (set! fails (+ fails 1)))
      (when (== a e) (set! fails (+ fails 1)))
      ;; error sides with equal content
      (when (not (== e f)) (set! fails (+ fails 1)))
      (set-put s a)
      (set-put s b)
      (set-put s e)
      (set-put s f)
      (when (!= (cast Int (list-len (set-elements s))) 2) (set! fails (+ fails 1)))
      (when (not (set-has s b)) (set! fails (+ fails 1)))
      (when (set-has s c) (set! fails (+ fails 1)))
      (when (set-has s d) (set! fails (+ fails 1)))
      (map-put m a 1)
      (match (map-get m b)
        ((some v) (when (!= v 1) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (match (map-get m c)
        ((some _) (set! fails (+ fails 1)))
        ((none) (do)))
      fails))

  (fn check-nested ((arena Arena))
    (@intent "An Option of a record, and a Result of a record or a String, compare by content")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (p12 (Option Pt) (some (Pt 1 2)))
          (p13 (Option Pt) (some (Pt 1 3)))
          (no-pt (Option Pt) (none))
          (to12 (move-to arena true (Pt 1 2)))
          (to13 (move-to arena true (Pt 1 3)))
          (lost1 (move-to arena false (Pt 0 0)))
          (lost2 (move-to arena false (Pt 0 0)))
          (a (Nested p12 to12))
          (b (Nested p12 to12))
          (c (Nested no-pt to12))
          (d (Nested p12 to13))
          (e (Nested no-pt lost1))
          (f (Nested no-pt lost2))
          (s (set-new arena Nested)))
      (when (not (== a b)) (set! fails (+ fails 1)))
      (when (== a c) (set! fails (+ fails 1)))
      (when (== a d) (set! fails (+ fails 1)))
      (when (not (== e f)) (set! fails (+ fails 1)))
      (set-put s a)
      (set-put s e)
      (when (not (set-has s b)) (set! fails (+ fails 1)))
      (when (not (set-has s f)) (set! fails (+ fails 1)))
      (when (set-has s c) (set! fails (+ fails 1)))
      (when (set-has s d) (set! fails (+ fails 1)))
      fails))

  (fn check-union-payloads ((arena Arena))
    (@intent "Option and Result union payloads compare by content (they used to be a transpiler error)")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (en1 (Option String) (some (fresh arena "en" "-GB")))
          (en2 (Option String) (some (fresh arena "en-" "GB")))
          (no-lang (Option String) (none))
          (five (parse-n arena 5))
          (bad1 (parse-n arena 0))
          (bad2 (parse-n arena -1))
          (xy1 (Option String) (some (fresh arena "x" "y")))
          (xy2 (Option String) (some (fresh arena "xy" "")))
          (a (union-new Term lit en1))
          (b (union-new Term lit en2))
          (c (union-new Term lit no-lang))
          (d (union-new Term res five))
          (e (union-new Term res five))
          (g (union-new Term res bad1))
          (h (union-new Term res bad2))
          (p (union-new Term both 1 xy1))
          (q (union-new Term both 1 xy2))
          (r (union-new Term both 2 xy1))
          (s (set-new arena Term)))
      (when (not (== a b)) (set! fails (+ fails 1)))
      (when (== a c) (set! fails (+ fails 1)))
      (when (not (== d e)) (set! fails (+ fails 1)))
      (when (not (== g h)) (set! fails (+ fails 1)))
      (when (== d g) (set! fails (+ fails 1)))
      (when (not (== p q)) (set! fails (+ fails 1)))
      (when (== p r) (set! fails (+ fails 1)))
      (set-put s a)
      (set-put s d)
      (set-put s g)
      (set-put s p)
      (when (not (set-has s b)) (set! fails (+ fails 1)))
      (when (not (set-has s e)) (set! fails (+ fails 1)))
      (when (not (set-has s h)) (set! fails (+ fails 1)))
      (when (not (set-has s q)) (set! fails (+ fails 1)))
      (when (set-has s c) (set! fails (+ fails 1)))
      (when (set-has s r) (set! fails (+ fails 1)))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if any content comparison failed")
    (@spec (() -> Int))
    (with-arena 65536
      (let ((mut fails 0))
        (set! fails (+ fails (check-record-fields arena)))
        (set! fails (+ fails (check-nested arena)))
        (set! fails (+ fails (check-union-payloads arena)))
        (when (> fails 0)
          (print "test_option_field_key failures: ")
          (println fails))
        fails))))
