;; A list literal with no arena in scope used to fall back to a C compound
;; literal on the stack, so one returned from its function pointed into a dead
;; frame (#245). Inside a function a list literal is now always copied into an
;; arena; a module const keeps a file-scope literal, which has static storage.

(module test-list-literal-escape
  (@intent "list literals outlive the function that built them")

  (type Holder (record (names (List String)) (n Int)))

  (const PRIMES (List Int) (list Int 2 3 5 7))

  (fn make-names ((arena Arena))
    (@intent "Return a list literal of constants")
    (@spec ((Arena) -> (List String)))
    (@alloc arena)
    (list String "alpha" "beta" "gamma"))

  (fn make-powers ((arena Arena) (n Int))
    (@intent "Return a list literal of computed elements")
    (@spec ((Arena Int) -> (List Int)))
    (@alloc arena)
    (list Int n (* n n) (* n (* n n))))

  (fn make-holder ((arena Arena))
    (@intent "Store a list literal in a record field")
    (@spec ((Arena) -> Holder))
    (@alloc arena)
    (record-new Holder (names (list String "x" "y")) (n 2)))

  (fn clobber ((depth Int))
    (@intent "Reuse the stack a returned literal's frame used to occupy")
    (@spec ((Int) -> Int))
    (let ((a (+ depth 1))
          (b (+ depth 2))
          (c (+ depth 3)))
      (if (> depth 0)
        (+ (clobber (- depth 1)) (+ a (+ b c)))
        0)))

  (fn name-at ((xs (List String)) (i Int))
    (@intent "Element i, or the empty string")
    (@spec (((List String) Int) -> String))
    (match (list-get xs i)
      ((some s) s)
      ((none) "")))

  (fn int-at ((xs (List Int)) (i Int))
    (@intent "Element i, or -1")
    (@spec (((List Int) Int) -> Int))
    (match (list-get xs i)
      ((some v) v)
      ((none) -1)))

  (fn check-returned ((arena Arena))
    (@intent "A returned literal still holds its elements after the frame is reused")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (xs (make-names arena))
          (ys (make-powers arena 3)))
      (when (<= (clobber 16) 0)
        (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len xs)) 3)
        (set! fails (+ fails 1)))
      (when (not (string-eq (name-at xs 0) "alpha"))
        (set! fails (+ fails 1)))
      (when (not (string-eq (name-at xs 2) "gamma"))
        (set! fails (+ fails 1)))
      (when (!= (int-at ys 0) 3)
        (set! fails (+ fails 1)))
      (when (!= (int-at ys 2) 27)
        (set! fails (+ fails 1)))
      fails))

  (fn check-fresh-per-call ((arena Arena))
    (@intent "Each evaluation builds its own list: a write to one is not seen by the next")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (first (make-names arena)))
      (when (not (list-set first 0 "changed"))
        (set! fails (+ fails 1)))
      (let ((second (make-names arena)))
        (when (not (string-eq (name-at second 0) "alpha"))
          (set! fails (+ fails 1)))
        (when (not (string-eq (name-at first 0) "changed"))
          (set! fails (+ fails 1))))
      fails))

  (fn check-field ((arena Arena))
    (@intent "A literal stored in a returned record's field survives")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (h (make-holder arena)))
      (when (<= (clobber 16) 0)
        (set! fails (+ fails 1)))
      (when (not (string-eq (name-at (. h names) 1) "y"))
        (set! fails (+ fails 1)))
      fails))

  (fn check-const ()
    (@intent "A module const list has its elements")
    (@spec (() -> Int))
    (let ((mut fails 0))
      (when (!= (cast Int (list-len PRIMES)) 4)
        (set! fails (+ fails 1)))
      (when (!= (int-at PRIMES 3) 7)
        (set! fails (+ fails 1)))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if any check failed")
    (@spec (() -> Int))
    (with-arena 65536
      (let ((mut fails 0))
        (set! fails (+ fails (check-returned arena)))
        (set! fails (+ fails (check-fresh-per-call arena)))
        (set! fails (+ fails (check-field arena)))
        (set! fails (+ fails (check-const)))
        (do (println (int-to-string arena fails)) fails)))))
