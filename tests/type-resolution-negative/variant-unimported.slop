;; main imports neither Color nor Paint, both have red, and nothing here
;; says which one p is. The transpiler must not pick either.
(module main
  (import hue (color-code))
  (import tint (paint-code))

  (fn main ()
    (@intent "Use a 'red that main never imports, with no type to take")
    (@spec (() -> Int))
    (let ((p 'red))
      (paint-code p))))
