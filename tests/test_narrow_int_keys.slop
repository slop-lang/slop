(module test-narrow-int-keys
  (@intent "Map and Set keys narrower than 64 bits hash and compare exactly their own width")

  ;; An I32 or U32 key was stored in 4 bytes but hashed and compared through
  ;; slop_hash_int / slop_eq_int, which read 8: the lookup read past its key
  ;; on the stack, and a stored key's upper half was whatever the arena held.
  ;; I16, I8, U16, U8 and Bool keys named hash functions that did not exist.

  (fn check-i32 ((arena Arena))
    (@intent "I32 keys, negative ones included")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (m (map-new arena I32 Int))
          (mut i 0))
      (while (< i 200)
        (map-put m (cast I32 (- i 100)) i)
        (set! i (+ i 1)))
      (set! i 0)
      (while (< i 200)
        (match (map-get m (cast I32 (- i 100)))
          ((some v) (when (!= v i) (set! fails (+ fails 1))))
          ((none) (set! fails (+ fails 1))))
        (set! i (+ i 1)))
      (when (map-has m (cast I32 100)) (set! fails (+ fails 1)))
      (map-remove m (cast I32 -100))
      (when (map-has m (cast I32 -100)) (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len (map-keys m))) 199) (set! fails (+ fails 1)))
      fails))

  (fn check-sets ((arena Arena))
    (@intent "I16, I8, U32, U16, U8 and Bool set elements")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (s16 (set-new arena I16))
          (s8 (set-new arena I8))
          (u32 (set-new arena U32))
          (u16 (set-new arena U16))
          (u8 (set-new arena U8))
          (flags (set-new arena Bool))
          (mut i 0))
      (while (< i 100)
        (set-put s16 (cast I16 (- 0 (* i 300))))
        (set-put s8 (cast I8 (- i 50)))
        (set-put u32 (cast U32 (* i 40000000)))
        (set-put u16 (cast U16 (* i 600)))
        (set-put u8 (cast U8 (* i 2)))
        (set! i (+ i 1)))
      (set-put flags true)
      (set! i 0)
      (while (< i 100)
        (when (not (set-has s16 (cast I16 (- 0 (* i 300))))) (set! fails (+ fails 1)))
        (when (not (set-has s8 (cast I8 (- i 50)))) (set! fails (+ fails 1)))
        (when (not (set-has u32 (cast U32 (* i 40000000)))) (set! fails (+ fails 1)))
        (when (not (set-has u16 (cast U16 (* i 600)))) (set! fails (+ fails 1)))
        (when (not (set-has u8 (cast U8 (* i 2)))) (set! fails (+ fails 1)))
        (set! i (+ i 1)))
      (when (set-has s8 (cast I8 50)) (set! fails (+ fails 1)))
      (when (set-has u8 (cast U8 1)) (set! fails (+ fails 1)))
      (when (not (set-has flags true)) (set! fails (+ fails 1)))
      (when (set-has flags false) (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len (set-elements u8))) 100) (set! fails (+ fails 1)))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if a narrow key was mishandled")
    (@spec (() -> Int))
    (with-arena 65536
      (let ((fails (+ (check-i32 arena) (check-sets arena))))
        (when (> fails 0)
          (print "test_narrow_int_keys failures: ")
          (println fails))
        fails))))
