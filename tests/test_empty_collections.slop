(module test-empty-collections
  (@intent "An empty List, Map or Set has no storage until first use, and every builtin works on it")

  ;; list-new makes {NULL, 0, 0}, and map-new / set-new make a map with no
  ;; table (cap 0, table NULL); the first push or put allocates the first
  ;; storage. Every read -- and every for-each, which walks .len directly --
  ;; has to work on that empty shape.

  (type Addressed (record (a Int) (b Int)))

  (type DeltaCtx (record
    (subsumers (Set Int))
    (succs (Map Int Int))
    (preds (Map Int Int))))

  (fn empty-rule ((arena Arena))
    (@intent "A rule that fires on nothing")
    (@spec ((Arena) -> (List Addressed)))
    (@alloc arena)
    (list-new arena Addressed))

  (fn check-lists ((arena Arena))
    (@intent "Every list builtin on an empty list, then growth from empty")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (mut xs (list-new arena Int))
          (mut seen 0))
      (when (!= (list-len xs) 0) (set! fails (+ fails 1)))
      (match (list-get xs 0)
        ((some _) (set! fails (+ fails 1)))
        ((none) (do)))
      (match (list-pop xs)
        ((some _) (set! fails (+ fails 1)))
        ((none) (do)))
      (when (list-set xs 0 5) (set! fails (+ fails 1)))
      (for-each (x xs) (set! seen (+ seen 1)))
      (when (!= seen 0) (set! fails (+ fails 1)))
      ;; A copy of an empty list: pushing to it leaves the original empty
      (let ((mut ys xs))
        (list-push ys 7)
        (when (!= (list-len ys) 1) (set! fails (+ fails 1)))
        (when (!= (list-len xs) 0) (set! fails (+ fails 1))))
      ;; Growth from empty, across a doubling
      (let ((mut i 0))
        (while (< i 40)
          (list-push xs i)
          (set! i (+ i 1))))
      (when (!= (list-len xs) 40) (set! fails (+ fails 1)))
      (match (list-get xs 39)
        ((some v) (when (!= v 39) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      ;; A rule that returns an empty list, and an empty list literal
      (when (!= (list-len (empty-rule arena)) 0) (set! fails (+ fails 1)))
      (when (!= (list-len (list Int)) 0) (set! fails (+ fails 1)))
      fails))

  (fn check-maps ((arena Arena))
    (@intent "Every map builtin on an empty map, then growth from empty")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (m (map-new arena String Int))
          (mut seen 0))
      (when (!= (map-len m) 0) (set! fails (+ fails 1)))
      (when (map-has m "a") (set! fails (+ fails 1)))
      (match (map-get m "a")
        ((some _) (set! fails (+ fails 1)))
        ((none) (do)))
      (map-remove m "a")
      (for-each (k m) (set! seen (+ seen 1)))
      (for-each ((k v) m) (set! seen (+ seen v)))
      (when (!= seen 0) (set! fails (+ fails 1)))
      (when (!= (list-len (map-keys m)) 0) (set! fails (+ fails 1)))
      ;; Growth from empty, across a resize
      (let ((mut i 0))
        (while (< i 100)
          (let ((key (int-to-string arena i)))
            (map-put m key i))
          (set! i (+ i 1))))
      (when (!= (map-len m) 100) (set! fails (+ fails 1)))
      (match (map-get m "42")
        ((some v) (when (!= v 42) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      fails))

  (fn check-sets ((arena Arena))
    (@intent "Every set builtin on an empty set, then growth from empty")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (s (set-new arena Int))
          (mut seen 0))
      (when (!= (set-len s) 0) (set! fails (+ fails 1)))
      (when (set-has s 1) (set! fails (+ fails 1)))
      (set-remove s 1)
      (for-each (x s) (set! seen (+ seen 1)))
      (when (!= seen 0) (set! fails (+ fails 1)))
      (when (!= (list-len (set-elements s)) 0) (set! fails (+ fails 1)))
      (set-put s 3)
      (set-put s 3)
      (when (!= (set-len s) 1) (set! fails (+ fails 1)))
      (when (not (set-has s 3)) (set! fails (+ fails 1)))
      fails))

  (fn check-shared ((arena Arena))
    (@intent "A record of three maps, one touched: the others stay empty and the record sees the write")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (ctx (DeltaCtx (set-new arena Int) (map-new arena Int Int) (map-new arena Int Int)))
          (succs (. ctx succs)))
      ;; The map is created up front and shared, so a put through one handle
      ;; is seen through the other, even when the put makes its first table
      (map-put succs 1 10)
      (match (map-get (. ctx succs) 1)
        ((some v) (when (!= v 10) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (when (!= (map-len (. ctx preds)) 0) (set! fails (+ fails 1)))
      (when (!= (set-len (. ctx subsumers)) 0) (set! fails (+ fails 1)))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if an empty collection misbehaves")
    (@spec (() -> Int))
    (with-arena 65536
      (let ((fails (+ (check-lists arena)
                      (+ (check-maps arena)
                         (+ (check-sets arena) (check-shared arena))))))
        (when (> fails 0)
          (print "test_empty_collections failures: ")
          (println fails))
        fails))))
