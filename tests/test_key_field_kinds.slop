(module test-key-field-kinds
  (@intent "Float, enum and alias record fields and union payloads hash and compare by value")

  ;; Generated hash/eq had no case for these. A Float field or payload named
  ;; slop_hash_double and an enum one slop_hash_<Enum>, neither of which
  ;; existed; a field declared through an alias of (Option String) named
  ;; slop_hash_slop_option_string. Only cc noticed. Each is now hashed by
  ;; value, with -0.0 and 0.0 -- which == calls equal -- hashing alike.

  (type Color (enum red green blue))
  (type NodeId (Int 0 ..))
  (type MaybeName (Option String))

  (type Reading (record
    (at F64)
    (hue Color)
    (name MaybeName)
    (node NodeId)))

  (type Sample (union
    (temp F64)
    (shade Color)
    (label MaybeName)
    (half F32)))

  (fn fresh ((arena Arena) (a String) (b String))
    (@intent "A new, uninterned string with the content a ++ b")
    (@spec ((Arena String String) -> String))
    (@alloc arena)
    (string-concat arena a b))

  (fn check-records ((arena Arena))
    (@intent "Record keys with Float, enum, alias-of-Option and range-alias fields")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (n1 MaybeName (some (fresh arena "no" "de")))
          (n2 MaybeName (some (fresh arena "n" "ode")))
          (a (Reading 0.0 'red n1 3))
          (b (Reading (* -1.0 0.0) 'red n2 3))
          (c (Reading 0.0 'green n1 3))
          (d (Reading 0.5 'red n1 3))
          (e (Reading 0.0 'red n1 4))
          (s (set-new arena Reading)))
      (when (not (== a b)) (set! fails (+ fails 1)))
      (when (== a c) (set! fails (+ fails 1)))
      (when (== a d) (set! fails (+ fails 1)))
      (when (== a e) (set! fails (+ fails 1)))
      (set-put s a)
      (when (not (set-has s b)) (set! fails (+ fails 1)))
      (when (set-has s c) (set! fails (+ fails 1)))
      (when (set-has s d) (set! fails (+ fails 1)))
      (when (set-has s e) (set! fails (+ fails 1)))
      fails))

  (fn check-unions ((arena Arena))
    (@intent "Union keys with F64, enum, alias-of-Option and F32 payloads")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (l1 MaybeName (some (fresh arena "la" "bel")))
          (l2 MaybeName (some (fresh arena "lab" "el")))
          (t1 (union-new Sample temp 0.0))
          (t2 (union-new Sample temp (* -1.0 0.0)))
          (t3 (union-new Sample temp 2.5))
          (g1 (union-new Sample shade 'green))
          (g2 (union-new Sample shade 'blue))
          (b1 (union-new Sample label l1))
          (b2 (union-new Sample label l2))
          (h1 (union-new Sample half (cast F32 1.25)))
          (h2 (union-new Sample half (cast F32 1.25)))
          (s (set-new arena Sample)))
      (when (not (== t1 t2)) (set! fails (+ fails 1)))
      (when (== t1 t3) (set! fails (+ fails 1)))
      (when (== g1 g2) (set! fails (+ fails 1)))
      (when (not (== b1 b2)) (set! fails (+ fails 1)))
      (when (not (== h1 h2)) (set! fails (+ fails 1)))
      (set-put s t1)
      (set-put s g1)
      (set-put s b1)
      (set-put s h1)
      (when (not (set-has s t2)) (set! fails (+ fails 1)))
      (when (not (set-has s b2)) (set! fails (+ fails 1)))
      (when (not (set-has s h2)) (set! fails (+ fails 1)))
      (when (set-has s t3) (set! fails (+ fails 1)))
      (when (set-has s g2) (set! fails (+ fails 1)))
      fails))

  (fn check-float-keys ((arena Arena))
    (@intent "A Set of Float: -0.0 finds 0.0")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (s (set-new arena Float))
          (m (map-new arena F32 Int)))
      (set-put s 0.0)
      (set-put s 1.5)
      (set-put s (* -1.0 0.0))
      (when (!= (cast Int (list-len (set-elements s))) 2) (set! fails (+ fails 1)))
      (when (not (set-has s (* -1.0 0.0))) (set! fails (+ fails 1)))
      (when (set-has s 2.5) (set! fails (+ fails 1)))
      (map-put m (cast F32 0.25) 1)
      (match (map-get m (cast F32 0.25))
        ((some v) (when (!= v 1) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if any key kind was mishandled")
    (@spec (() -> Int))
    (with-arena 65536
      (let ((fails (+ (check-records arena)
                      (+ (check-unions arena) (check-float-keys arena)))))
        (when (> fails 0)
          (print "test_key_field_kinds failures: ")
          (println fails))
        fails))))
