;; transpile-list-expr dispatches on the head symbol before it consults the
;; function registry, so a call to one of these names becomes the builtin
;; whatever else is in scope. A definition would resolve in the checker and then
;; lower to the builtin, and cc would report the difference - or worse, nothing
;; would, and the call would quietly go somewhere else.
;;
;; The transpiler cannot resolve that on its own -- its FuncEntry carries no
;; module, so a lookup sees every module in the build, and a dependency defining
;; the name would disable the builtin in an unrelated module that never imported
;; it. So the definition is refused here, where module-name is known.
;;
;; Every declaration form that can claim a name is covered: a function, a type,
;; an FFI function and an ffi-struct. infer-expr tries env-lookup-function and
;; then env-lookup-type before reaching its builtins, so both spellings matter,
;; and the two FFI forms register directly, bypassing the (fn ...) path.

(module test-option-predicate-reserved

  ;; An FFI declaration registers its signature directly, bypassing the (fn ...)
  ;; path, so it is one of the ways to make the checker and the transpiler
  ;; disagree about one of these names.
  (ffi "stdlib.h" (is-some ((n Int)) Bool))

  (type is-some (record (w Int)))

  ;; ffi-struct declares a type and the checker registers nothing for it, so it
  ;; was the last declaration form that could claim one of these names.
  (ffi-struct "stddef.h" is-none (x Int))

  (fn is-none ((n Int))
    (@intent "A function of a reserved name")
    (@spec ((Int) -> Bool))
    (== n 0))

  (fn list-set ((xs (List Int)) (i Int) (v Int))
    (@intent "A function of a reserved name")
    (@spec (((List Int) Int Int) -> Bool))
    true)

  ;; One from each group of the dispatch, so a name dropped from the list shows
  ;; up here rather than in cc.
  (fn list-push ((n Int))
    (@intent "A list operation, reserved since #110")
    (@spec ((Int) -> Int))
    n)

  (fn map-get ((n Int))
    (@intent "A map operation, on the second half of the collection chain")
    (@spec ((Int) -> Int))
    n)

  (fn record-new ((n Int))
    (@intent "A constructor")
    (@spec ((Int) -> Int))
    n)

  (fn arena-new ((n Int))
    (@intent "An arena operation")
    (@spec ((Int) -> Int))
    n)

  (fn with-arena ((n Int))
    (@intent "Syntax the transpiler lowers by name is reserved too")
    (@spec ((Int) -> Int))
    n))
