;; Negative fixture for #107: is-none / is-some on something that is not an
;; (Option T). Each call must be named by the checker rather than reaching cc,
;; where it would surface as a missing struct member on `.has_value`.

(module test-option-predicate-bad-arg

  (type Point (record (x Int) (y Int)))

  (type Meters (Int 0 .. 100))

  ;; A symbol alias, which collect.slop DOES record an inner for -- unlike the
  ;; form alias in the positive fixture. Following that chain is what turns this
  ;; from an exemption into a rejection.
  (type MyInt Int)

  ;; Ten deep, to prove the chain guard is a cycle guard and not a depth cliff.
  ;; A chain that stops early lands on a non-builtin primitive, which is exempt,
  ;; so the miss would be silent and the error would surface in cc instead.
  (type D1 Int) (type D2 D1) (type D3 D2) (type D4 D3) (type D5 D4)
  (type D6 D5) (type D7 D6) (type D8 D7) (type D9 D8) (type D10 D9)

  (fn bad-int ()
    (@intent "An Int is not an Option")
    (@spec (() -> Bool))
    (is-none 5))

  (fn bad-record ()
    (@intent "A record is not an Option")
    (@spec (() -> Bool))
    (is-some (Point 1 2)))

  (fn bad-list ()
    (@intent "A List is not an Option, despite also being a container")
    (@spec (() -> Bool))
    (with-arena 4096
      (is-none (list-new arena Int))))

  (fn bad-range ((m Meters))
    (@intent "A range alias is definitely not an Option")
    (@spec ((Meters) -> Bool))
    (is-none m))

  (fn bad-symbol-alias ((x MyInt))
    (@intent "An alias to a builtin scalar is not an Option")
    (@spec ((MyInt) -> Bool))
    (is-none x))

  ;; Left alone this one reaches cc as "member reference base type 'int64_t' is
  ;; not a structure or union", which CLAUDE.md calls a failure outright. SLOP
  ;; cannot constrain a type parameter to be an Option, so this is never valid.
  (fn bad-typevar ((x T))
    (@intent "A bare type parameter cannot be known to be an Option")
    (@spec ((T) -> Bool))
    (@generic (T))
    (is-some x))

  (fn bad-deep-alias ((x D10))
    (@intent "A ten-deep alias still resolves to a builtin scalar")
    (@spec ((D10) -> Bool))
    (is-none x))

  ;; rk-primitive is overloaded: collect.slop registers (Set T) under it too,
  ;; with c-name "slop_map*" and the ELEMENT type as its inner. So a Set is a
  ;; resolved container, not an unresolved alias, and following that inner would
  ;; walk into the element and call a (Set (Option Int)) an Option. Left alone
  ;; this reached cc as "no member named 'has_value' in 'slop_map'".
  (fn bad-set-of-option ()
    (@intent "A Set whose element type is an Option is still a Set")
    (@spec (() -> Bool))
    (with-arena 4096
      (is-none (set-new arena (Option Int)))))

  (fn bad-arity ()
    (@intent "One argument, not two")
    (@spec (() -> Bool))
    (with-arena 4096
      (let ((xs (list-new arena Int)))
        (is-some (list-get xs 0) 3)))))
