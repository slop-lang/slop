;; Reassign an unmarked Ptr parameter: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((p (Ptr Node)))
    (@intent "Reassign an unmarked Ptr parameter")
    (@spec (((Ptr Node)) -> Int))
    (set! p nil) 0)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (f nil)))
