;; A word that is not a mode: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((ref x Int))
    (@intent "A word that is not a mode")
    (@spec ((Int) -> Int))
    x)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (f 1)))
