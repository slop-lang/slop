;; Reassign an unmarked parameter inside an expression: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((n Int))
    (@intent "Reassign an unmarked parameter inside an expression")
    (@spec ((Int) -> Int))
    (let ((r (do (set! n 2) 1))) (+ r n)))

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (f 1)))
