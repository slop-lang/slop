;; Reassign an unmarked parameter: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((n Int))
    (@intent "Reassign an unmarked parameter")
    (@spec ((Int) -> Int))
    (set! n 2) n)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (f 1)))
