;; Push onto a List field of an unmarked record parameter: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((arena Arena) (b Bag))
    (@intent "Push onto a List field of an unmarked record parameter")
    (@spec ((Arena Bag) -> Int))
    (list-push (. b items) 1) 0)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (with-arena 256 (f arena (Bag (list-new arena Int) 0)))))
