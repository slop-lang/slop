;; A mut parameter of a Map alias: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((mut m Scores))
    (@intent "A mut parameter of a Map alias")
    (@spec ((Scores) -> Int))
    0)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    0))
