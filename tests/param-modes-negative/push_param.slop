;; Push onto an unmarked List parameter: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((arena Arena) (xs (List Int)))
    (@intent "Push onto an unmarked List parameter")
    (@spec ((Arena (List Int)) -> Int))
    (list-push xs 1) 0)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (with-arena 256 (f arena (list-new arena Int)))))
