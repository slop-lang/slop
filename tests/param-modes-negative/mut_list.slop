;; A mut List parameter: an error in both slop check and slop build (#180).

(module main
  (type Bag (record (items (List Int)) (n Int)))
  (type Node (record (v Int) (next (Ptr Node))))
  (type Scores (Map String Int))

  (fn f ((mut xs (List Int)))
    (@intent "A mut List parameter")
    (@spec (((List Int)) -> Int))
    0)

  (fn main ()
    (@intent "Must fail")
    (@spec (() -> Int))
    (with-arena 256 (f (list-new arena Int)))))
