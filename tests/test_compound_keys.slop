(module test-compound-keys
  (@intent "Option, Result, range and alias types key a Map or Set by their own hash")

  ;; Every compound key but (Ptr T) used to get the String hash and
  ;; sizeof(slop_string): a range key was read as 16 bytes, an Option key's
  ;; has_value as a string length. Aliases of either got a bytewise hash of
  ;; the alias, which for an (Option String) meant its pointer and padding.

  (type Ids (Option String))
  (type Small (Int 0 .. 99))

  (fn fresh ((arena Arena) (a String) (b String))
    (@intent "A new, uninterned string with the content a ++ b")
    (@spec ((Arena String String) -> String))
    (@alloc arena)
    (string-concat arena a b))

  (fn checked ((arena Arena) (n Int))
    (@intent "ok n for a positive n, else a freshly allocated error")
    (@spec ((Arena Int) -> (Result Int String)))
    (@alloc arena)
    (if (> n 0) (ok n) (error (fresh arena "neg" "ative"))))

  (fn check-option-keys ((arena Arena))
    (@intent "A Set of (Option String) and a Set of its alias")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (s (set-new arena (Option String)))
          (t (set-new arena Ids))
          (a1 (Option String) (some (fresh arena "ab" "c")))
          (a2 (Option String) (some (fresh arena "a" "bc")))
          (n1 (Option String) (none))
          (i1 Ids (some (fresh arena "x" "yz")))
          (i2 Ids (some (fresh arena "xy" "z"))))
      (set-put s a1)
      (set-put s n1)
      (when (not (set-has s a2)) (set! fails (+ fails 1)))
      (when (not (set-has s n1)) (set! fails (+ fails 1)))
      (set-put s a2)
      (when (!= (cast Int (list-len (set-elements s))) 2) (set! fails (+ fails 1)))
      (set-put t i1)
      (when (not (set-has t i2)) (set! fails (+ fails 1)))
      (when (set-has t a1) (set! fails (+ fails 1)))
      fails))

  (fn check-result-keys ((arena Arena))
    (@intent "A Map keyed by (Result Int String)")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (m (map-new arena (Result Int String) Int)))
      (map-put m (checked arena 5) 50)
      (map-put m (checked arena -1) 99)
      (match (map-get m (checked arena 5))
        ((some v) (when (!= v 50) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (match (map-get m (checked arena -7))
        ((some v) (when (!= v 99) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (when (map-has m (checked arena 6)) (set! fails (+ fails 1)))
      fails))

  (fn check-range-keys ((arena Arena))
    (@intent "Maps keyed by an inline range type and by a range alias")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (m (map-new arena (Int 0 .. 255) Int))
          (n (map-new arena Small Int))
          (mut i 0))
      (while (< i 100)
        (map-put m i (* i 2))
        (map-put n i (* i 3))
        (set! i (+ i 1)))
      (set! i 0)
      (while (< i 100)
        (match (map-get m i)
          ((some v) (when (!= v (* i 2)) (set! fails (+ fails 1))))
          ((none) (set! fails (+ fails 1))))
        (match (map-get n i)
          ((some v) (when (!= v (* i 3)) (set! fails (+ fails 1))))
          ((none) (set! fails (+ fails 1))))
        (set! i (+ i 1)))
      (when (map-has m 200) (set! fails (+ fails 1)))
      fails))

  (fn main ()
    (@intent "Entry point: non-zero exit if any compound key was mishandled")
    (@spec (() -> Int))
    (with-arena 65536
      (let ((fails (+ (check-option-keys arena)
                      (+ (check-result-keys arena) (check-range-keys arena)))))
        (when (> fails 0)
          (print "test_compound_keys failures: ")
          (println fails))
        fails))))
