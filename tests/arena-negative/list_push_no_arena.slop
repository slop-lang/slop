;; list-push may have to grow the list, and nothing here says where: no
;; arena variable, no arena field. It used to emit the bare identifier
;; `arena`, leaving the C compiler to report it (#179).

(module main
  (fn grow ((xs (Ptr (List Int))))
    (@intent "Push with no arena in scope")
    (@spec (((Ptr (List Int))) -> Unit))
    (list-push (deref xs) 1))

  (fn main ()
    (@intent "Build must fail")
    (@spec (() -> Int))
    (with-arena 1024
      (let ((mut xs (list-new arena Int)))
        (grow (addr xs))
        (cast Int (list-len xs))))))
