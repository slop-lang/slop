(module test-list-set
  (@intent "list-set writes an element in place and reports whether it could")

  (type Point (record (x Int) (y Int)))

  (fn check-ints ((arena Arena))
    (@intent "In-range write lands, out-of-range write is refused and changes nothing")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (xs (list-new arena Int)))
      (list-push xs 10)
      (list-push xs 20)
      (list-push xs 30)
      (when (not (list-set xs 1 99))
        (set! fails (+ fails 1)))
      (match (list-get xs 1)
        ((some v) (when (!= v 99) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (when (list-set xs 3 7)
        (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len xs)) 3)
        (set! fails (+ fails 1)))
      (match (list-get xs 0)
        ((some v) (when (!= v 10) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (match (list-get xs 2)
        ((some v) (when (!= v 30) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      fails))

  (fn check-empty ((arena Arena))
    (@intent "A list with no elements refuses every index, including zero")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (xs (list-new arena Int)))
      (when (list-set xs 0 1)
        (set! fails (+ fails 1)))
      (when (!= (cast Int (list-len xs)) 0)
        (set! fails (+ fails 1)))
      fails))

  (fn check-records ((arena Arena))
    (@intent "A record element is replaced whole")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (ps (list-new arena Point)))
      (list-push ps (record-new Point (x 1) (y 2)))
      (list-push ps (record-new Point (x 3) (y 4)))
      (when (not (list-set ps 0 (record-new Point (x 7) (y 8))))
        (set! fails (+ fails 1)))
      (match (list-get ps 0)
        ((some p)
          (do (when (!= (. p x) 7) (set! fails (+ fails 1)))
              (when (!= (. p y) 8) (set! fails (+ fails 1)))))
        ((none) (set! fails (+ fails 1))))
      (match (list-get ps 1)
        ((some p) (when (!= (. p x) 3) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      fails))

  (fn check-side-effect-order ((arena Arena))
    (@intent "The value is evaluated even when the index is out of range")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (mut evaluated 0)
          (xs (list-new arena Int)))
      (when (list-set xs 0 (do (set! evaluated 1) 5))
        (set! fails (+ fails 1)))
      (when (!= evaluated 1)
        (set! fails (+ fails 1)))
      fails))

  (fn check-reverse ((arena Arena))
    (@intent "An in-place reverse, the thing list-set exists to make writable")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((mut fails 0)
          (xs (list-new arena Int))
          (mut i 0))
      (list-push xs 1)
      (list-push xs 2)
      (list-push xs 3)
      (list-push xs 4)
      (let ((n (cast Int (list-len xs))))
        (while (< i (/ n 2))
          (let ((j (- (- n 1) i)))
            (match (list-get xs i)
              ((some a)
                (match (list-get xs j)
                  ((some b)
                    (do (when (not (list-set xs i b)) (set! fails (+ fails 1)))
                        (when (not (list-set xs j a)) (set! fails (+ fails 1)))))
                  ((none) (set! fails (+ fails 1)))))
              ((none) (set! fails (+ fails 1)))))
          (set! i (+ i 1))))
      (match (list-get xs 0)
        ((some v) (when (!= v 4) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      (match (list-get xs 3)
        ((some v) (when (!= v 1) (set! fails (+ fails 1))))
        ((none) (set! fails (+ fails 1))))
      fails))

  (fn call-local ((list-set (Fn (Int Int Int) Bool)))
    (@intent "A (Fn ...) parameter named list-set is an ordinary callable")
    (@spec (((Fn (Int Int Int) Bool)) -> Bool))
    (list-set 1 2 3))

  (fn always-false ((a Int) (b Int) (c Int))
    (@intent "Something to pass under that name")
    (@spec ((Int Int Int) -> Bool))
    false)

  (fn check-local-shadow ((arena Arena))
    (@intent "A local of the name wins over the builtin, as for is-none")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (if (call-local always-false) 1 0))

  (fn main ()
    (@intent "Entry point: non-zero exit if any check failed")
    (@spec (() -> Int))
    (with-arena 262144
      (let ((mut fails 0))
        (set! fails (+ fails (check-ints arena)))
        (set! fails (+ fails (check-empty arena)))
        (set! fails (+ fails (check-records arena)))
        (set! fails (+ fails (check-side-effect-order arena)))
        (set! fails (+ fails (check-reverse arena)))
        (set! fails (+ fails (check-local-shadow arena)))
        (do (println (int-to-string arena fails)) fails)))))
