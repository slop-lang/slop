(module map-lookup
  (@intent "Micro-benchmark: Map/Set lookups keyed by a union and a record holding a ~50-byte IRI")

  ;; Shaped after HOWL's hot path: keys are unions and records whose payload is
  ;; an IRI string of 40-60 bytes. Each key is built once and the same values
  ;; are looked up repeatedly, as a reasoner passes its nodes around; a second
  ;; batch built separately, with IRIs not in the map, supplies the misses.
  ;;
  ;; Build and run:  slop build bench/map_lookup.slop -o /tmp/map_lookup -O 2
  ;;                 /tmp/map_lookup
  ;; Prints the elapsed milliseconds for each phase and a checksum that must
  ;; not change between runtimes.

  (type Node (union (iri String) (anon Int)))
  (type Edge (record (src String) (dst Int)))

  (const KEYS Int 100000)
  (const ROUNDS Int 50)

  (fn make-iri ((arena Arena) (prefix String) (i Int))
    (@intent "A ~50-byte IRI ending in i")
    (@spec ((Arena String Int) -> String))
    (@alloc arena)
    (string-concat arena prefix (int-to-string arena i)))

  (fn node-keys ((arena Arena) (prefix String))
    (@intent "KEYS iri nodes under prefix")
    (@spec ((Arena String) -> (List Node)))
    (@alloc arena)
    (let ((keys (list-new arena Node))
          (mut i 0))
      (while (< i KEYS)
        (list-push keys (union-new Node iri (make-iri arena prefix i)))
        (set! i (+ i 1)))
      keys))

  (fn edge-keys ((arena Arena) (prefix String))
    (@intent "KEYS edges under prefix")
    (@spec ((Arena String) -> (List Edge)))
    (@alloc arena)
    (let ((keys (list-new arena Edge))
          (mut i 0))
      (while (< i KEYS)
        (list-push keys (Edge (make-iri arena prefix i) (% i 7)))
        (set! i (+ i 1)))
      keys))

  (fn bench-nodes ((arena Arena))
    (@intent "Insert KEYS union keys, then look up hits and misses ROUNDS times over")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((hits (node-keys arena "http://www.co-ode.org/ontologies/galen#Concept_"))
          (misses (node-keys arena "http://www.co-ode.org/ontologies/galen#Missing_"))
          (m (map-new arena Node Int))
          (t0 (now-ms))
          (mut sum 0)
          (mut i 0))
      (while (< i KEYS)
        (match (list-get hits i)
          ((some k) (map-put m k i))
          ((none) (do)))
        (set! i (+ i 1)))
      (let ((t1 (now-ms))
            (mut r 0))
        (while (< r ROUNDS)
          (set! i 0)
          (while (< i KEYS)
            (match (list-get hits i)
              ((some k)
                (match (map-get m k)
                  ((some v) (set! sum (+ sum v)))
                  ((none) (do))))
              ((none) (do)))
            (match (list-get misses i)
              ((some k) (when (map-has m k) (set! sum (+ sum 1))))
              ((none) (do)))
            (set! i (+ i 1)))
          (set! r (+ r 1)))
        (let ((t2 (now-ms)))
          (print "union  insert ms: ") (println (- t1 t0))
          (print "union  lookup ms: ") (println (- t2 t1))
          sum))))

  (fn bench-edges ((arena Arena))
    (@intent "Insert KEYS record keys into a Set, then test membership ROUNDS times over")
    (@spec ((Arena) -> Int))
    (@alloc arena)
    (let ((hits (edge-keys arena "http://www.co-ode.org/ontologies/galen#Relation_"))
          (misses (edge-keys arena "http://www.co-ode.org/ontologies/galen#Missings_"))
          (s (set-new arena Edge))
          (t0 (now-ms))
          (mut sum 0)
          (mut i 0))
      (while (< i KEYS)
        (match (list-get hits i)
          ((some k) (set-put s k))
          ((none) (do)))
        (set! i (+ i 1)))
      (let ((t1 (now-ms))
            (mut r 0))
        (while (< r ROUNDS)
          (set! i 0)
          (while (< i KEYS)
            (match (list-get hits i)
              ((some k) (when (set-has s k) (set! sum (+ sum 1))))
              ((none) (do)))
            (match (list-get misses i)
              ((some k) (when (set-has s k) (set! sum (+ sum 1000))))
              ((none) (do)))
            (set! i (+ i 1)))
          (set! r (+ r 1)))
        (let ((t2 (now-ms)))
          (print "record insert ms: ") (println (- t1 t0))
          (print "record lookup ms: ") (println (- t2 t1))
          sum))))

  (fn main ()
    (@intent "Run both benchmarks and print a checksum")
    (@spec (() -> Int))
    (with-arena 67108864
      (let ((a (bench-nodes arena))
            (b (bench-edges arena)))
        (print "checksum: ") (println (+ a b))
        0))))
